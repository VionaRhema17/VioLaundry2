<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.android.laundry.MainActivity">

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selamat Pagi, Viona"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="08 Januari 2025"
        android:textSize="16dp"
        android:textColor="@color/text"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

    <androidx.cardview.widget.CardView
        android:id="@+id/c1"
        android:layout_width="370dp"
        android:layout_height="150dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="28dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="@id/tvsiap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDate">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:text="@string/Estimasi"
            android:textColor="@color/text"
            android:textSize="17dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="230dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:text="Rp."
            android:textColor="@color/text"
            android:textSize="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="265dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/text"
            android:layout_marginEnd="10dp"
            android:text="40.000,-"
            android:textSize="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="40dp"
            android:background="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="125dp"
            android:text="@string/Transaksi"
            android:textColor="@color/text"
            android:textSize="16dp" />

        <ImageView
            android:id="@+id/card_masuk_transaksi"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="49dp"
            android:src="@drawable/transaksi"/>


        <ImageView
            android:id="@+id/card_masuk_pelanggan"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="145dp"
            android:layout_marginTop="49dp"
            android:src="@drawable/pelanggan"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="145dp"
            android:layout_marginTop="125dp"
            android:text="@string/Pelanggan"
            android:textColor="@color/text"
            android:textSize="16dp" />

        <ImageView
            android:id="@+id/card_masuk_laporan"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="270dp"
            android:layout_marginTop="49dp"
            android:src="@drawable/laporan"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="270dp"
            android:layout_marginTop="125dp"
            android:text="@string/Laporan"
            android:textColor="@color/text"
            android:textSize="16dp" />


    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvsiap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Siap melayani pelanggan dengan setulus hati"
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:gravity="center"
        android:paddingTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/c1"
        app:layout_constraintBottom_toTopOf="@id/Tvjangan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/Tvjangan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jangan kecewakan Pelanggan"
        android:textSize="17dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="15dp"
        android:textColor="@color/text"
        app:layout_constraintTop_toBottomOf="@id/tvsiap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_masuk_akun"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toStartOf="@id/card_masuk_layanan"
        app:layout_constraintStart_toStartOf="parent"
        app:cardCornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/Tvjangan">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Akun"
            android:textSize="16dp"
            android:layout_marginTop="80dp"
            android:textColor="@color/text"
            android:layout_marginStart="40dp"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/akun" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_masuk_layanan"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toStartOf="@id/card_masuk_tambah"
        app:layout_constraintStart_toEndOf="@id/card_masuk_akun"
        app:layout_constraintTop_toBottomOf="@id/Tvjangan">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Layanan"
            android:textSize="16dp"
            android:textColor="@color/text"
            android:layout_marginTop="80dp"
            android:layout_marginStart="25dp"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="69dp"
            android:layout_marginTop="10dp"
            android:id="@+id/imagelayanan"
            android:src="@drawable/layanan" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_masuk_tambah"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/Tvjangan"
        app:layout_constraintStart_toEndOf="@id/card_masuk_layanan"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Tambahan"
            android:textSize="16dp"
            android:layout_marginTop="80dp"
            android:textColor="@color/text"
            android:layout_marginStart="20dp" />

        <ImageView
            android:id="@+id/imageTambahan"
            android:layout_width="wrap_content"
            android:layout_height="71dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/tambahan" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_masuk_pegawai"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toStartOf="@id/card_masuk_cabang"
        app:cardCornerRadius="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_masuk_akun">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="80dp"
            android:text="@string/Pegawai"
            android:textColor="@color/text"
            android:textSize="16dp"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:id="@+id/imagepegawai"
            android:layout_marginTop="10dp"
            android:src="@drawable/pegawai" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_masuk_cabang"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toStartOf="@id/card_masuk_cetak"
        app:layout_constraintStart_toEndOf="@id/card_masuk_pegawai"
        app:cardCornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/card_masuk_layanan">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Cabang"
            android:textColor="@color/text"
            android:textSize="16dp"
            android:layout_marginTop="80dp"
            android:layout_marginStart="30dp"/>

        <ImageView
            android:id="@+id/imagecabang"
            android:layout_width="wrap_content"
            android:layout_height="63dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/cabang" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_masuk_cetak"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/card_masuk_tambah"
        app:layout_constraintStart_toEndOf="@id/card_masuk_cabang"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Cetak"
            android:textSize="16dp"
            android:textAlignment="center"
            android:textColor="@color/text"
            android:layout_marginTop="80dp"
            android:layout_marginStart="30dp"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/printer" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>